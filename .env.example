# =============================================================================
# NPC Rwanda - Environment configuration
# Copy this file to .env (or configure the same variables in your VPS environment)
# Replace every placeholder with your own values. Never commit the real .env file.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV="production"
PORT="3000"

# Public website base URL. Used when generating absolute links and callbacks.
PUBLIC_APP_URL="https://npcrwanda.org"
# Optional compatibility alias; PUBLIC_APP_URL takes priority.
NEXT_PUBLIC_PUBLIC_APP_URL="https://npcrwanda.org"

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# PostgreSQL connection string. URL-encode special characters in the password.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Generate a long, unique random secret. Do not use the development fallback.
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# -----------------------------------------------------------------------------
# Cloudinary media uploads
# Obtain these from your Cloudinary dashboard.
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="YOUR_CLOUD_NAME"
CLOUDINARY_API_KEY="YOUR_CLOUDINARY_API_KEY"
CLOUDINARY_API_SECRET="YOUR_CLOUDINARY_API_SECRET"
# Optional combined Cloudinary URL, if another integration requires it.
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"

# -----------------------------------------------------------------------------
# SMTP email delivery
# Used for verified donation receipts and other system emails.
# Use your provider's SMTP host, port, username and app password.
# SMTP settings saved in the admin System Settings take priority over these.
# -----------------------------------------------------------------------------
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_USER="notifications@npcrwanda.org"
SMTP_PASS="YOUR_SMTP_APP_PASSWORD"
SMTP_FROM="NPC Rwanda <notifications@npcrwanda.org>"
# true for port 465; false for STARTTLS providers commonly using port 587.
SMTP_SECURE="true"

# -----------------------------------------------------------------------------
# Flutterwave online donations
# Use TEST keys while testing. Replace them with LIVE keys only after approval.
# Keep FLW_SECRET_KEY and FLW_SECRET_HASH server-side; never expose them publicly.
# -----------------------------------------------------------------------------
FLW_PUBLIC_KEY="FLWPUBK_TEST-YOUR_PUBLIC_KEY"
FLW_SECRET_KEY="FLWSECK_TEST-YOUR_SECRET_KEY"
# Create a strong random value and enter the exact same value in Flutterwave's
# webhook secret-hash setting.
FLW_SECRET_HASH="REPLACE_WITH_A_RANDOM_WEBHOOK_SECRET"

# Flutterwave USD -> RWF conversion for USD donations paid through Rwanda
# mobile money. Use an approved/current rate and update its date regularly.
# The application rejects missing, future-dated, or more-than-7-day-old rates.
USD_RWF_MOBILE_MONEY_RATE=""
USD_RWF_MOBILE_MONEY_RATE_DATE=""

# -----------------------------------------------------------------------------
# Database migration / seed safeguards
# -----------------------------------------------------------------------------
# Build-time Prisma migrations are disabled by default. Enable only when you
# intentionally want the build script to run migrations against DATABASE_URL.
RUN_PRISMA_MIGRATIONS="false"

# Destructive seed script safeguard. Keep false in all normal environments.
# Only set true against a disposable development/test database when explicitly
# running the destructive seed script.
ALLOW_DESTRUCTIVE_SEED="false"
